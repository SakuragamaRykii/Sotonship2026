# Copy to .env and fill in. .env is gitignored. Only needed for the LLM client (M5).
# Provider: anthropic | openai | ollama | dryrun  (dryrun logs the payload and sends nothing)
LLM_PROVIDER=dryrun
LLM_MODEL=
# e.g. LLM_PROVIDER=ollama with LLM_MODEL=qwen3:8b runs fully locally

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=

# Local Ollama (used by the L5 quasi-identifier detector and the ollama provider)
OLLAMA_HOST=http://localhost:11434
